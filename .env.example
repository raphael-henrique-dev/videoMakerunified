# Configurações do Motor Gerador de Vídeos 2.0
# Copie este arquivo para .env e preencha suas chaves:
# cp .env.example .env

ELEVENLABS_API_KEY=sua_chave_aqui
TELEGRAM_BOT_TOKEN=seu_token_telegram_aqui
AUTHORIZED_TELEGRAM_USER_ID=seu_id_usuario_aqui
OPENCODE_SERVER_PASSWORD=sua_senha_aqui

# ==============================================================================
# Publicação Automática: YouTube Shorts (Google Cloud OAuth 2.0)
# Obtenha em: https://console.cloud.google.com/ (Ativar "YouTube Data API v3")
# URI de Redirecionamento autorizada: http://localhost:3000/oauth2callback
# ==============================================================================
YOUTUBE_CLIENT_ID=seu_client_id_google.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=seu_client_secret_google
YOUTUBE_REFRESH_TOKEN=preenchido_automaticamente_pelo_comando_auth_youtube

# ==============================================================================
# Publicação Automática: TikTok (TikTok Developers / Content Posting API v2)
# Obtenha em: https://developers.tiktok.com/ (Content Posting API)
# Redirect URI configurada: http://localhost:3000/oauth2callback
# ==============================================================================
TIKTOK_CLIENT_KEY=seu_client_key_tiktok
TIKTOK_CLIENT_SECRET=seu_client_secret_tiktok
TIKTOK_REFRESH_TOKEN=preenchido_automaticamente_pelo_comando_auth_tiktok
OAUTH_PORT=3000
